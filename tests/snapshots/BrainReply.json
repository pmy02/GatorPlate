{
 "$defs": {
  "Lang": {
   "enum": [
    "en",
    "es"
   ],
   "title": "Lang",
   "type": "string"
  },
  "ReplyDebug": {
   "additionalProperties": true,
   "description": "Schema: an object whose two properties are optional and whose extra properties are allowed.",
   "properties": {
    "keys": {
     "items": {
      "minLength": 1,
      "type": "string"
     },
     "title": "Keys",
     "type": "array"
    },
    "phase": {
     "default": "",
     "title": "Phase",
     "type": "string"
    }
   },
   "title": "ReplyDebug",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "description": "Every field is required; ask, display, choices, card_url, debug and end_reason are nullable.",
 "properties": {
  "ask": {
   "anyOf": [
    {
     "maxLength": 300,
     "minLength": 1,
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "title": "Ask"
  },
  "card_url": {
   "anyOf": [
    {
     "pattern": "^/c/[A-Za-z0-9_-]{22,64}$",
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "title": "Card Url"
  },
  "choices": {
   "anyOf": [
    {
     "items": {
      "maxLength": 60,
      "minLength": 1,
      "type": "string"
     },
     "maxItems": 6,
     "minItems": 1,
     "type": "array"
    },
    {
     "type": "null"
    }
   ],
   "title": "Choices"
  },
  "debug": {
   "anyOf": [
    {
     "$ref": "#/$defs/ReplyDebug"
    },
    {
     "type": "null"
    }
   ]
  },
  "display": {
   "anyOf": [
    {
     "maxLength": 1500,
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "title": "Display"
  },
  "end": {
   "title": "End",
   "type": "boolean"
  },
  "end_reason": {
   "anyOf": [
    {
     "enum": [
      "completed",
      "no_input",
      "declined"
     ],
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "title": "End Reason"
  },
  "expect": {
   "enum": [
    "open",
    "yes_no",
    "confirm",
    "number",
    "choice"
   ],
   "title": "Expect",
   "type": "string"
  },
  "hold_s": {
   "maximum": 60,
   "minimum": 0,
   "title": "Hold S",
   "type": "integer"
  },
  "interruptible": {
   "title": "Interruptible",
   "type": "boolean"
  },
  "lang": {
   "$ref": "#/$defs/Lang"
  },
  "listen": {
   "enum": [
    "normal",
    "long"
   ],
   "title": "Listen",
   "type": "string"
  },
  "say": {
   "maxLength": 1000,
   "title": "Say",
   "type": "string"
  }
 },
 "required": [
  "say",
  "ask",
  "end",
  "end_reason",
  "lang",
  "listen",
  "expect",
  "interruptible",
  "hold_s",
  "display",
  "choices",
  "card_url",
  "debug"
 ],
 "title": "BrainReply",
 "type": "object"
}
