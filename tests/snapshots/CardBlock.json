    "answer": {
     "title": "Answer",
     "type": "string"
    },
    "question": {
     "title": "Question",
     "type": "string"
    },
    "screen": {
     "title": "Screen",
     "type": "string"
    }
   },
   "required": [
    "screen",
    "question",
    "answer"
   ],
   "title": "CardRow",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "properties": {
  "bullets": {
   "items": {
    "type": "string"
   },
   "title": "Bullets",
   "type": "array"
  },
  "collapsed": {
   "default": false,
   "title": "Collapsed",
   "type": "boolean"
  },
  "id": {
   "title": "Id",
   "type": "string"
  },
  "paragraphs": {
   "items": {
    "type": "string"
   },
   "title": "Paragraphs",
   "type": "array"
  },
  "rows": {
