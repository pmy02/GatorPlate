{
 "$defs": {
  "CardBlock": {
   "additionalProperties": false,
   "properties": {
    "bullets": {
     "items": {
      "type": "string"
     },
     "title": "Bullets",
     "type": "array"
    },
    "collapsed": {
     "default": false,
     "title": "Collapsed",
     "type": "boolean"
    },
    "id": {
     "title": "Id",
     "type": "string"
    },
    "paragraphs": {
     "items": {
      "type": "string"
     },
     "title": "Paragraphs",
     "type": "array"
    },
    "rows": {
     "items": {
      "$ref": "#/$defs/CardRow"
     },
     "title": "Rows",
     "type": "array"
    },
    "title": {
     "title": "Title",
     "type": "string"
    },
    "tone": {
     "default": "default",
     "enum": [
      "default",
      "accent",
      "warning",
      "muted"
     ],
     "title": "Tone",
     "type": "string"
    }
   },
   "required": [
    "id",
    "title"
   ],
   "title": "CardBlock",
   "type": "object"
  },
  "CardRow": {
   "additionalProperties": false,
   "description": "One row of a form helper table: the official screen name, its question and the student's answer.\n\nDefined here (and re-exported by card_api) so that programs.py can use it without an import cycle.",
   "properties": {
    "answer": {
     "title": "Answer",
     "type": "string"
    },
    "question": {
     "title": "Question",
     "type": "string"
    },
    "screen": {
     "title": "Screen",
     "type": "string"
    }
   },
   "required": [
    "screen",
    "question",
    "answer"
   ],
   "title": "CardRow",
   "type": "object"
  },
  "CardStatus": {
   "additionalProperties": false,
   "properties": {
    "estimate_monthly": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "title": "Estimate Monthly"
    },
    "reviewed": {
     "title": "Reviewed",
     "type": "boolean"
    },
    "reviewed_at": {
     "anyOf": [
      {
       "format": "date-time",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Reviewed At"
    },
    "status": {
     "$ref": "#/$defs/CaseStatus"
    },
    "tier": {
     "anyOf": [
      {
       "$ref": "#/$defs/Tier"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "status",
    "reviewed",
    "reviewed_at",
    "tier",
    "estimate_monthly"
   ],
   "title": "CardStatus",
   "type": "object"
  },
  "CaseStatus": {
   "description": "Coordinator status of a case (docs/UI_SPEC.md A3.7). \"Live\", \"Ended early\" and \"Sample\" are badges.",
   "enum": [
    "new",
    "reviewed",
    "applied",
    "interview_scheduled",
    "approved",
    "follow_up"
   ],
   "title": "CaseStatus",
   "type": "string"
  },
  "FirstMonth": {
   "additionalProperties": false,
   "properties": {
    "amount": {
     "title": "Amount",
     "type": "integer"
    },
    "apply_date": {
     "format": "date",
     "title": "Apply Date",
     "type": "string"
    },
    "days_counted": {
     "title": "Days Counted",
     "type": "integer"
    },
    "estimate": {
     "default": true,
     "title": "Estimate",
     "type": "boolean"
    },
    "filed_on": {
     "format": "date",
     "title": "Filed On",
     "type": "string"
    },
    "month_label": {
     "title": "Month Label",
     "type": "string"
    }
   },
   "required": [
    "apply_date",
    "filed_on",
    "amount",
    "days_counted",
    "month_label"
   ],
   "title": "FirstMonth",
   "type": "object"
  },
  "Lang": {
   "enum": [
    "en",
    "es"
   ],
   "title": "Lang",
   "type": "string"
  },
  "SourceRef": {
   "additionalProperties": false,
   "properties": {
    "date": {
     "title": "Date",
     "type": "string"
    },
    "grade": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Grade"
    },
    "id": {
     "title": "Id",
     "type": "string"
    },
    "title": {
     "title": "Title",
     "type": "string"
    },
    "url": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Url"
    }
   },
   "required": [
    "id",
    "title",
    "date"
   ],
   "title": "SourceRef",
   "type": "object"
  },
  "Tier": {
   "enum": [
    "likely",
    "coordinator",
    "other_help"
   ],
   "title": "Tier",
   "type": "string"
  },
  "UnlockedChoice": {
   "additionalProperties": false,
   "properties": {
    "label": {
     "title": "Label",
     "type": "string"
    },
    "value": {
     "title": "Value",
     "type": "string"
    }
   },
   "required": [
    "value",
    "label"
   ],
   "title": "UnlockedChoice",
   "type": "object"
  },
  "UnlockedProgram": {
   "additionalProperties": false,
   "properties": {
    "applied": {
     "title": "Applied",
     "type": "boolean"
    },
    "apply_by_text": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Apply By Text"
    },
    "apply_label": {
     "title": "Apply Label",
     "type": "string"
    },
    "apply_url": {
     "title": "Apply Url",
     "type": "string"
    },
    "can_mark_applied": {
     "title": "Can Mark Applied",
     "type": "boolean"
    },
    "counted": {
     "title": "Counted",
     "type": "boolean"
    },
    "id": {
     "title": "Id",
     "type": "string"
    },
    "line": {
     "title": "Line",
     "type": "string"
    },
    "name": {
     "title": "Name",
     "type": "string"
    },
    "notes": {
     "items": {
      "type": "string"
     },
     "title": "Notes",
     "type": "array"
    },
    "prefill": {
     "items": {
      "$ref": "#/$defs/CardRow"
     },
     "title": "Prefill",
     "type": "array"
    },
    "source_text": {
     "title": "Source Text",
     "type": "string"
    },
    "stage": {
     "enum": [
      "today",
      "after_approval",
      "tax_time"
     ],
     "title": "Stage",
     "type": "string"
    },
    "stage_label": {
     "title": "Stage Label",
     "type": "string"
    },
    "status": {
     "enum": [
      "likely",
      "maybe",
      "check",
      "coverage",
      "zero",
      "note"
     ],
     "title": "Status",
     "type": "string"
    },
    "status_label": {
     "title": "Status Label",
     "type": "string"
    },
    "value_text": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Value Text"
    }
   },
   "required": [
    "id",
    "name",
    "status",
    "status_label",
    "value_text",
    "counted",
    "line",
    "notes",
    "stage",
    "stage_label",
    "apply_by_text",
    "apply_url",
    "apply_label",
    "applied",
    "can_mark_applied",
    "prefill",
    "source_text"
   ],
   "title": "UnlockedProgram",
   "type": "object"
  },
  "UnlockedQuestion": {
   "additionalProperties": false,
   "properties": {
    "choices": {
     "items": {
      "$ref": "#/$defs/UnlockedChoice"
     },
     "title": "Choices",
     "type": "array"
    },
    "id": {
     "title": "Id",
     "type": "string"
    },
    "index": {
     "title": "Index",
     "type": "integer"
    },
    "text": {
     "title": "Text",
     "type": "string"
    },
    "total": {
     "title": "Total",
     "type": "integer"
    }
   },
   "required": [
    "id",
    "text",
    "choices",
    "index",
    "total"
   ],
   "title": "UnlockedQuestion",
   "type": "object"
  },
  "UnlockedView": {
   "additionalProperties": false,
   "description": "Everything the card widget shows, in one language; every string passed the output guard.",
   "properties": {
    "calfresh_display": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "title": "Calfresh Display"
    },
    "chips": {
     "items": {
      "type": "string"
     },
     "title": "Chips",
     "type": "array"
    },
    "claimed_display": {
     "title": "Claimed Display",
     "type": "integer"
    },
    "footnote": {
     "title": "Footnote",
     "type": "string"
    },
    "found_display": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "title": "Found Display"
    },
    "labels": {
     "additionalProperties": {
      "type": "string"
     },
     "title": "Labels",
     "type": "object"
    },
    "lang": {
     "$ref": "#/$defs/Lang"
    },
    "mode": {
     "enum": [
      "full",
      "list_only"
     ],
     "title": "Mode",
     "type": "string"
    },
    "programs": {
     "items": {
      "$ref": "#/$defs/UnlockedProgram"
     },
     "title": "Programs",
     "type": "array"
    },
    "question": {
     "anyOf": [
      {
       "$ref": "#/$defs/UnlockedQuestion"
      },
      {
       "type": "null"
      }
     ]
    },
    "segments": {
     "items": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
       {
        "type": "string"
       },
       {
        "type": "integer"
       }
      ],
      "type": "array"
     },
     "title": "Segments",
     "type": "array"
    },
    "share_text": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Share Text"
    },
    "title": {
     "title": "Title",
     "type": "string"
    },
    "total_text": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Total Text"
    }
   },
   "required": [
    "mode",
    "title",
    "total_text",
    "found_display",
    "claimed_display",
    "calfresh_display",
    "segments",
    "question",
    "chips",
    "programs",
    "share_text",
    "footnote",
    "labels",
    "lang"
   ],
   "title": "UnlockedView",
   "type": "object"
  }
 },
