    },
    "apply_label": {
     "title": "Apply Label",
     "type": "string"
    },
    "apply_url": {
     "title": "Apply Url",
     "type": "string"
    },
    "can_mark_applied": {
     "title": "Can Mark Applied",
     "type": "boolean"
    },
    "counted": {
     "title": "Counted",
     "type": "boolean"
    },
    "id": {
     "title": "Id",
     "type": "string"
    },
    "line": {
     "title": "Line",
     "type": "string"
    },
    "name": {
     "title": "Name",
     "type": "string"
    },
    "notes": {
     "items": {
      "type": "string"
     },
     "title": "Notes",
     "type": "array"
    },
    "prefill": {
     "items": {
      "$ref": "#/$defs/CardRow"
     },
     "title": "Prefill",
     "type": "array"
    },
    "source_text": {
     "title": "Source Text",
     "type": "string"
    },
    "stage": {
     "enum": [
      "today",
      "after_approval",
      "tax_time"
     ],
     "title": "Stage",
     "type": "string"
    },
    "stage_label": {
     "title": "Stage Label",
     "type": "string"
    },
    "status": {
     "enum": [
      "likely",
      "maybe",
      "check",
      "coverage",
      "zero",
      "note"
     ],
     "title": "Status",
     "type": "string"
    },
    "status_label": {
     "title": "Status Label",
     "type": "string"
    },
    "value_text": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Value Text"
    }
   },
   "required": [
    "id",
    "name",
    "status",
    "status_label",
    "value_text",
    "counted",
    "line",
    "notes",
    "stage",
    "stage_label",
    "apply_by_text",
    "apply_url",
    "apply_label",
    "applied",
    "can_mark_applied",
    "prefill",
    "source_text"
   ],
   "title": "UnlockedProgram",
   "type": "object"
  },
  "UnlockedQuestion": {
   "additionalProperties": false,
   "properties": {
