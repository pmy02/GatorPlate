     "items": {
      "$ref": "#/$defs/UnlockedChoice"
     },
     "title": "Choices",
     "type": "array"
    },
    "id": {
     "title": "Id",
     "type": "string"
    },
    "index": {
     "title": "Index",
     "type": "integer"
    },
    "text": {
     "title": "Text",
     "type": "string"
    },
    "total": {
     "title": "Total",
     "type": "integer"
    }
   },
   "required": [
    "id",
    "text",
    "choices",
    "index",
    "total"
   ],
   "title": "UnlockedQuestion",
   "type": "object"
  }
 },
