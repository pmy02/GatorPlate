   "type": "integer"
  },
  "footnote": {
   "title": "Footnote",
   "type": "string"
  },
  "found_display": {
   "anyOf": [
    {
     "type": "integer"
    },
    {
     "type": "null"
    }
   ],
   "title": "Found Display"
  },
  "labels": {
   "additionalProperties": {
